<!-- Row counts for the 4 column grid. findBestGridSize() picks the biggest entry that fits
     the display, so with both thresholds at 0 every handheld lands on 4x6, matching Pixel.
     Raise minDeviceHeightPx on the 4x6 entry in a device overlay to fall back to 4x5 on
     shorter panels. -->
<GridSizeSpecs xmlns:launcher="http://schemas.android.com/apk/res-auto">
    <GridSize
        launcher:numGridColumns="4"
        launcher:numGridRows="5"
        launcher:dbFile="launcher_4_by_5.db"
        launcher:defaultLayoutId="@xml/default_workspace_4x5"
        launcher:minDeviceWidthPx="0"
        launcher:minDeviceHeightPx="0"
        />
    <GridSize
        launcher:numGridColumns="4"
        launcher:numGridRows="6"
        launcher:dbFile="launcher_4_by_6.db"
        launcher:defaultLayoutId="@xml/default_workspace_4x6"
        launcher:minDeviceWidthPx="0"
        launcher:minDeviceHeightPx="0"
        />
</GridSizeSpecs>
